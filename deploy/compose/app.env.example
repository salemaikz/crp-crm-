# Образец /etc/crm/app.env (root, 0600) для compose-проекта. Только плейсхолдеры, секретов в git нет.
# Полный список переменных и их смысл — docs/CONFIG.md §7.
# Хост БД в compose — db; пароли те же, что в db.env.
DATABASE_URL=postgres://crm_app:CHANGE_ME_APP@db:5432/crm
MIGRATE_DATABASE_URL=postgres://crm_owner:CHANGE_ME_OWNER@db:5432/crm
APP_ORIGIN=https://crm.example.kz
# Секрет доверенного прокси (D-155): base64url от 32 символов, генерирует crmctl install (и дописывает
# crmctl update). nginx ставит его в X-Proxy-Secret (/etc/crm/nginx-proxy.d/secret.conf); только с ним
# приложение верит X-Real-IP и X-Via-Proxy. В production без него приложение не стартует (docs/CONFIG.md §7).
CRM_PROXY_SECRET=
# 32 байта в base64: openssl rand -base64 32
CRM_SECRETS_KID=k1
CRM_SECRETS_KEY_k1=
CRM_PHONE_HMAC_KEY=
CRM_IIN_HMAC_KEY=
LICENSE_PATH=/var/lib/crm/license/license.crm
# Каталог ассетов (логотип темы, D-333) задаёт compose.yaml у app и ctl вместе с томом crm_assets — здесь не нужен.
# Строка в app.env значение compose не перекрывает (D-334):
# CRM_ASSETS_DIR=/var/lib/crm/assets
INGEST_PUBLIC=0
TELEMETRY=off
# Флаги модулей (1/0), в production без значения выключены:
# FEATURE_KANBAN=1
# FEATURE_REPORTS=1
# FEATURE_SALES_SETTINGS=1
# WhatsApp через Wazzup: включать только после письменного решения о передаче данных за рубеж (D-026, D-270).
# FEATURE_WAZZUP=1 также открывает frame-src для окна чата в nginx (crmctl update пишет /etc/crm/nginx-csp.d/frame.conf).
# FEATURE_WAZZUP=0
