# Образец окружения для разработки (копия в .env.local). Только синтетические значения.
# Боевой файл /etc/crm/app.env создаёт установка, в git его нет (docs/CONFIG.md §7).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crm_dev
# Только для тестов: адрес Postgres 16 для интеграционных тестов (схемы создаются и удаляются сами)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crm_test
# Флаги модулей: 1 — вкл, 0 — выкл. Не задан: вне production включён, в production выключен.
# FEATURE_KANBAN=1
# FEATURE_REPORTS=1
# FEATURE_SALES_SETTINGS=1
