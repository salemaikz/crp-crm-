# Образец /etc/crm/backup.env (root, 0600). Читает только задание копий на хосте. Значений секретов нет.
# Прямой режим (CI, стенд): адрес БД с правом читать всё и создавать временную БД проверки.
# BACKUP_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/crm
# Боевой режим: порта БД наружу нет, утилиты pg_* идут через контейнер db.
BACKUP_PG_EXEC=docker exec -i crm-db-1
BACKUP_DB_USER=crm_owner
BACKUP_DB_NAME=crm

# Отдельный том для копий и файл статуса, который читает healthcheck.
BACKUP_DIR=/var/backups/crm
BACKUP_STATUS_FILE=/var/lib/crm/backup-status.json

# Публичные ключи двух хранителей (владелец и директор), по строке на ключ. Закрытых ключей на сервере нет.
BACKUP_RECIPIENTS_FILE=/etc/crm/backup-recipients.txt

# Сколько копий хранить на томе: часовые (рабочий день пилота), дневные, недельные (DEPLOY 6.1).
BACKUP_KEEP_HOURLY=12
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Имя временной БД проверки восстановления; удаляются только БД с префиксом crm_restorecheck.
BACKUP_VERIFY_DB=crm_restorecheck

# Второй сервер. Пока 0 — копии остаются только на томе (D-044): включать после письменного
# подтверждения провайдера, что ЦОД второго сервера в Республике Казахстан.
BACKUP_OFFSITE_DC_CONFIRMED_KZ=0
# BACKUP_OFFSITE_TARGET=crmbackup@SECOND_SERVER:/srv/crm-backups/in
# BACKUP_OFFSITE_SSH_KEY=/etc/crm/backup_offsite_ed25519
# BACKUP_OFFSITE_KINDS=hourly,daily,weekly
