{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.age)",
      "Read(./**/license-private*)",
      "Read(./**/release-private*)",
      "Read(./**/*.env)",
      "Read(./**/*.key)",
      "Read(./**/id_ed25519*)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ecdsa*)",
      "Read(./**/stage-private*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.test)",
      "Edit(./**/.env.staging)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.age)",
      "Edit(./**/license-private*)",
      "Edit(./**/release-private*)",
      "Edit(./**/*.env)",
      "Edit(./**/*.key)",
      "Edit(./**/id_ed25519*)",
      "Edit(./**/id_rsa*)",
      "Edit(./**/id_ecdsa*)",
      "Edit(./**/stage-private*)"
    ]
  }
}
